<component name="ProjectRunConfigurationManager">
  <!-- La app del chofer.

       El argumento de abajo es lo que entrega las llaves al lado Dart. Sin
       GOOGLE_MAPS_API_KEY toda la app dibuja el mapa esquemático y la
       búsqueda de direcciones se queda sin llave con que llamar. La ruta es
       relativa a la carpeta de la app, que es desde donde el plugin de
       Flutter ejecuta. -->
  <configuration default="false" name="Chofer" type="FlutterRunConfigurationType" factoryName="Flutter">
    <option name="additionalArgs" value="--dart-define-from-file=../../.env" />
    <option name="buildFlavor" value="" />
    <option name="filePath" value="$PROJECT_DIR$/apps/driver_app/lib/main.dart" />
    <method v="2" />
  </configuration>
</component>
