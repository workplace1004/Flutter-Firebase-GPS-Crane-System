rules_version = '2';

// Grúas RD 24/7 — Firestore access model.
//
// The governing rule: the apps read, the server writes. Every field that
// decides who gets paid, who is assigned, or what a tow costs is written only
// by a Cloud Function through the Admin SDK, which bypasses these rules
// entirely. So most collections below are read-only to clients and the `write`
// clauses are deliberately `false` rather than a clever condition — a rule that
// can be reasoned about wrongly is worse than one that cannot be written at all.
//
// The single exception is chat. Messages are written straight from the apps so
// they land instantly, and the constraints on that write are correspondingly
// specific: the sender must be the author, the service must be one of theirs,
// the text must be a sane length, and no other field may appear.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Kept, unused, for the change that provisions App Check. Retrofitting it
    // after launch means a forced-update release, so it should go back into
    // ok() as soon as the clients can actually produce a token.
    function hasAppCheck() {
      return request.app != null;
    }

    // No client calls FirebaseAppCheck.activate() yet, so requiring a token
    // here denies every read and write the apps make - it does not raise the
    // bar for an attacker, it just takes the product offline. Add
    // hasAppCheck() back in the same change that provisions App Check in the
    // console, activates it in the Flutter bootstrap, and sets
    // ENFORCE_APP_CHECK=true on the functions. All four together, or none.
    function ok() {
      return isSignedIn();
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return request.auth.token.get('role', '');
    }

    function isAdmin() {
      return ok() && role() == 'admin';
    }

    // Dispatchers can see everything and assign work, but cannot create
    // accounts, change tariffs or manage roles.
    function isStaff() {
      return ok() && (role() == 'admin' || role() == 'ops');
    }

    function isDriver() {
      return ok() && role() == 'driver';
    }

    // People of an insurance company. The claim names the company; the two
    // documents below say whether the company is active and whether this
    // person still is. Both are read because a token outlives a suspension or
    // a deactivation by up to an hour. Paths are built from the token, never
    // from the document being read, so a query can always be judged.
    function myInsurerId() {
      return request.auth.token.get('insurerId', '');
    }

    function insurerMemberDoc() {
      return get(/databases/$(database)/documents/insurers/$(myInsurerId())/members/$(uid())).data;
    }

    function isActiveInsurer() {
      return ok()
        && role() == 'insurer'
        && myInsurerId() != ''
        && get(/databases/$(database)/documents/insurers/$(myInsurerId())).data.get('status', '') == 'active'
        && insurerMemberDoc().get('active', false) == true;
    }

    function isActiveInsurerOf(insurerId) {
      return isActiveInsurer() && myInsurerId() == insurerId;
    }

    function isInsurerManagerOf(insurerId) {
      return isActiveInsurerOf(insurerId)
        && insurerMemberDoc().get('insurerRole', '') == 'manager';
    }

    // A tow the caller's own company ordered. Queries must filter on
    // insurerId == the caller's company, or they are refused whole.
    function isInsurerFor(svc) {
      return isActiveInsurer() && svc.get('insurerId', '') == myInsurerId();
    }

    // Reads the service being addressed. Costs one document read, which is why
    // it is only used where the answer genuinely depends on the parent.
    function serviceDoc(serviceId) {
      return get(/databases/$(database)/documents/services/$(serviceId)).data;
    }

    function isPartyTo(svc) {
      return ok() && (uid() == svc.clientId || uid() == svc.get('driverId', ''));
    }

    // True when the incoming document changes nothing outside `allowed`.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(allowed);
    }

    // Deleting for everyone: the content is blanked and `deletedAt` stamped,
    // leaving a tombstone both sides render as "se eliminó este mensaje".
    // Either party to the conversation may do it, to their own message or the
    // other person's — the caller is checked to be in the conversation where
    // this is used, and the tombstone keeps the deletion visible to both.
    function isRetraction() {
      return onlyChanges(['deletedAt', 'text', 'imageUrl'])
        && request.resource.data.text == ''
        && request.resource.data.get('imageUrl', '') == ''
        && request.resource.data.deletedAt == request.time;
    }

    // Whether the person on the other end of a conversation blocked the
    // caller. Blocking stops the messages at the door, not only on screen.
    function isBlockedBy(otherUid) {
      return exists(
        /databases/$(database)/documents/users/$(otherUid)/blocked/$(uid())
      );
    }

    // A chat message the apps may write, in a job's chat or a chat request's.
    // Either words or a photo, never an empty bubble, and no other field —
    // `sentAt` is the server's stamp and `readAt` is set by the reader.
    function isSendableMessage(message) {
      return message.text is string
        && message.text.size() <= 1000
        && message.get('imageUrl', '') is string
        && message.get('imageUrl', '').size() <= 800
        && (message.text.size() > 0 || message.get('imageUrl', '').size() > 0)
        && message.keys().hasOnly([
             'senderId', 'senderRole', 'text', 'clientMsgId',
             'sentAt', 'readAt', 'imageUrl'
           ]);
    }

    // ---------------------------------------------------------------------
    // users — the customer's own profile
    // ---------------------------------------------------------------------

    match /users/{userId} {
      allow read: if ok() && (uid() == userId || isStaff());

      // Creation goes through an Auth blocking function so the server decides
      // the role, not the client.
      allow create: if false;

      // A whitelist, not a blacklist. `blocked` and `activeServiceId` are both
      // things a modified client would love to set.
      allow update: if ok() && uid() == userId && onlyChanges([
        'name', 'email', 'rnc', 'address', 'locale', 'preferredPaymentMethod',
        'photoUrl', 'updatedAt',
        'termsAcceptedAt', 'termsVersionAccepted'
      ]);

      allow delete: if false;

      // Saved vehicles and places are the customer's own scratch space.
      match /vehicles/{vehicleId} {
        allow read, write: if ok() && uid() == userId;
      }
      match /places/{placeId} {
        allow read, write: if ok() && uid() == userId;
      }

      // One document per device, so a token FCM reports as unregistered can be
      // deleted by id rather than pruned out of an array.
      match /tokens/{tokenId} {
        allow read, write: if ok() && uid() == userId;
      }

      // Each person's own view of their conversations: what they emptied,
      // what they took off their list, and who they blocked. Private to them,
      // and it never touches the messages the other side sees.
      match /chatState/{threadKey} {
        allow read, write: if ok() && uid() == userId;
      }

      // The owner keeps the list. The one person a document names may read
      // that document — how the app can say "te bloqueó" instead of failing a
      // send — but only the owner may list who else is on it.
      match /blocked/{blockedUid} {
        allow get: if ok() && (uid() == userId || uid() == blockedUid);
        allow list: if ok() && uid() == userId;
        allow write: if ok() && uid() == userId;
      }

      // The in-app inbox: written by triggers, marked read by the owner.
      match /notifications/{notificationId} {
        allow read: if ok() && uid() == userId;
        allow update: if ok() && uid() == userId && onlyChanges(['readAt']);
        allow create, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // drivers — created and controlled by the office
    // ---------------------------------------------------------------------

    match /drivers/{driverId} {
      allow read: if ok() && (uid() == driverId || isStaff());

      // Every field here decides whether somebody can work or what they are
      // owed. All of it is server-written.
      allow write: if false;

      match /documents/{docType} {
        allow read: if ok() && (uid() == driverId || isStaff());
        allow write: if false;
      }

      match /tokens/{tokenId} {
        allow read, write: if ok() && uid() == driverId;
      }
    }

    // ---------------------------------------------------------------------
    // trucks
    // ---------------------------------------------------------------------

    match /trucks/{truckId} {
      // A chofer needs to read the grúa assigned to them; the fleet list is
      // staff-only.
      allow read: if isStaff() ||
        (isDriver() && resource.data.get('assignedDriverId', '') == uid());
      allow write: if false;
    }

    match /trucks_by_plate/{plate} {
      // A uniqueness index, written transactionally by createTruck.
      allow read: if isStaff();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // offers, across every service
    // ---------------------------------------------------------------------

    // The chofer app finds its open offer with a collection-group query — it
    // does not know which service it is for until it arrives — and Firestore
    // judges those only against a recursive match like this one, never the
    // nested one under /services. The query is required to filter on the
    // caller's own driverId, so nobody can list anyone else's offers.
    match /{path=**}/offers/{offerId} {
      allow read: if isStaff() ||
        (ok() && resource.data.get('driverId', '') == uid());
    }

    // ---------------------------------------------------------------------
    // services — the order
    // ---------------------------------------------------------------------

    match /services/{serviceId} {
      allow read: if isStaff() || isPartyTo(resource.data)
        || isInsurerFor(resource.data);

      // Status, driver, quote and payment are the whole system. None of them
      // are ever written from a phone.
      allow create, update, delete: if false;

      // One exclusive offer per chofer. Only the addressee can see theirs —
      // a chofer must not be able to enumerate what everyone else was offered.
      match /offers/{driverId} {
        allow read: if isStaff() || (ok() && uid() == driverId);
        allow write: if false;
      }

      // What an insurer's tow pays the chofer and keeps for the company. The
      // insurance company can read the service, so the split lives here,
      // where only the office can.
      match /internal/{docId} {
        allow read: if isStaff();
        allow write: if false;
      }

      // The append-only transition log. This is the audit trail, so nothing
      // may edit or remove an entry.
      match /events/{eventId} {
        allow read: if isStaff() || isPartyTo(serviceDoc(serviceId))
          || isInsurerFor(serviceDoc(serviceId));
        allow write: if false;
      }

      // The one subcollection the apps write directly.
      match /messages/{messageId} {
        allow read: if isStaff() || isPartyTo(serviceDoc(serviceId));

        allow create: if ok()
          && isPartyTo(serviceDoc(serviceId))
          // Chat opens when a chofer is assigned and closes when the job ends.
          && serviceDoc(serviceId).status in
             ['accepted', 'arrived', 'in_progress']
          && request.resource.data.senderId == uid()
          && isSendableMessage(request.resource.data)
          && !isBlockedBy(uid() == serviceDoc(serviceId).clientId
               ? serviceDoc(serviceId).get('driverId', '')
               : serviceDoc(serviceId).clientId);

        // Two edits only: the reader stamps `readAt`, and the sender
        // retracts what they wrote. Nothing else about a message changes.
        allow update: if ok()
          && isPartyTo(serviceDoc(serviceId))
          && (onlyChanges(['readAt']) || isRetraction());

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // calls — voice calls between a customer and their chofer
    // ---------------------------------------------------------------------

    // Readable by the two people on the call, so each app can watch it ring,
    // connect and end. Every write is the server's: who may call, and what
    // state a call is in, are not a phone's to decide.
    match /calls/{callId} {
      allow read: if isStaff() ||
        (ok() && (resource.data.callerId == uid() || resource.data.calleeId == uid()));
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // chatRequests — a customer talking to a nearby chofer before any job
    // ---------------------------------------------------------------------

    // Created and answered only through the requestChat / respondChatRequest
    // callables, which open the sealed truck ref; the two parties can read it.
    // Queries must filter on the caller's own clientId or driverId.
    match /chatRequests/{requestId} {
      allow read: if isStaff() ||
        (ok() && (resource.data.clientId == uid() || resource.data.driverId == uid()));
      allow write: if false;

      function chatRequestDoc() {
        return get(/databases/$(database)/documents/chatRequests/$(requestId)).data;
      }

      function isChatParty(chat) {
        return ok() && (uid() == chat.clientId || uid() == chat.driverId);
      }

      // Written from the apps like a job's chat, but only while the chofer has
      // accepted and the conversation has not closed.
      match /messages/{messageId} {
        allow read: if isStaff() || isChatParty(chatRequestDoc());

        allow create: if isChatParty(chatRequestDoc())
          && chatRequestDoc().status == 'accepted'
          && request.time < chatRequestDoc().closesAt
          && request.resource.data.senderId == uid()
          && isSendableMessage(request.resource.data)
          && !isBlockedBy(uid() == chatRequestDoc().clientId
               ? chatRequestDoc().driverId
               : chatRequestDoc().clientId);

        allow update: if isChatParty(chatRequestDoc())
          && (onlyChanges(['readAt']) || isRetraction());

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // tracking — the chofer's live position on one service
    // ---------------------------------------------------------------------

    // Mirrored from RTDB by a trigger so the customer subscribes to exactly one
    // document and never gains read access to the rest of the fleet.
    match /tracking/{serviceId} {
      allow read: if isStaff() || isPartyTo(serviceDoc(serviceId))
        || isInsurerFor(serviceDoc(serviceId));
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // insurers — insurance companies billed monthly for their tows
    // ---------------------------------------------------------------------

    // Opened and edited only through the insurer callables. A company sees
    // its own record; nobody sees another company's.
    match /insurers/{insurerId} {
      allow read: if isStaff() || isActiveInsurerOf(insurerId);
      allow write: if false;

      // The company's people. A manager sees all of them; anyone else only
      // their own record, which is how the panel learns their role.
      match /members/{memberId} {
        allow read: if isStaff()
          || isInsurerManagerOf(insurerId)
          || (isActiveInsurerOf(insurerId) && uid() == memberId);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // pricingRules — zone prices insurance companies are billed on
    // ---------------------------------------------------------------------

    // A row with no insurerId is the default list; a row with one is that
    // company's negotiated price. A company sees the default list and its own
    // rows, never another company's. Queries must filter on insurerId.
    // Written only by the office, through a callable.
    match /pricingRules/{ruleId} {
      allow read: if isStaff()
        || (isActiveInsurer()
            && (resource.data.insurerId == null
                || resource.data.insurerId == myInsurerId()));
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // money
    // ---------------------------------------------------------------------

    match /invoices/{invoiceId} {
      allow read: if isStaff() || (ok() && resource.data.clientId == uid());
      allow write: if false;
    }

    match /earnings/{driverId} {
      allow read: if isStaff() || (ok() && uid() == driverId);
      allow write: if false;

      match /{document=**} {
        allow read: if isStaff() || (ok() && uid() == driverId);
        allow write: if false;
      }
    }

    // Weekly cortes: what the company and a chofer owe each other for a week.
    // Written only by the settlement callables; a chofer reads their own.
    // Queries must filter on the caller's driverId.
    match /driverSettlements/{settlementId} {
      allow read: if isStaff() || (ok() && uid() == resource.data.driverId);
      allow write: if false;
    }

    // Monthly invoices to insurance companies, with their NCF. Written only by
    // the invoicing callables. The office reads them all; a company's managers
    // read their own. Queries must filter on the caller's insurerId.
    match /insurerInvoices/{invoiceId} {
      allow read: if isStaff() || isInsurerManagerOf(resource.data.insurerId);
      allow write: if false;
    }

    // The company's fiscal details and NCF ranges: the office reads them, only
    // the fiscal callables write them.
    match /fiscal/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Every NCF ever issued, so none is issued twice. Server only.
    match /ncfRegistry/{key} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cortes: cash a chofer handed in to the office. Written only by
    // settleDriverCash; the office and the chofer it concerns can read it.
    match /cashSettlements/{settlementId} {
      allow read: if isStaff() || (ok() && uid() == resource.data.driverId);
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // configuration and reporting
    // ---------------------------------------------------------------------

    match /config/{document} {
      // Tariffs and dispatch tuning are readable by any signed-in app so the
      // client can show a price breakdown; only the server writes them.
      allow read: if ok();
      allow write: if false;

      // NCF sequences are a different matter: they are fiscal numbering, and
      // nothing outside the allocator has any business reading them.
      match /ncf/{sequence} {
        allow read, write: if false;
      }
    }

    match /reports/{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /audit/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A customer's review of a chofer, with who wrote it: the office's only.
    // The chofer reads the anonymous copy kept on their own driver record.
    match /driverReviews/{serviceId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Everything not named above is denied.
    //
    // Without this a new collection is readable by nobody but also silently
    // un-modelled; with it, an unmatched path fails loudly the first time
    // somebody adds a feature and forgets the rules.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
